+/// SUM/MIN/MAX on fixed-width sources: values can be loaded for a whole batch before the atomics.
+/// (Namespace-scope constant so the host-only trait functions are only constant-evaluated.)
+template <typename Source, cudf::aggregation::Kind k>
+inline constexpr bool shmem_batch_preload_v =
+  (k == cudf::aggregation::SUM && cudf::is_fixed_width<Source>() &&
+   !cudf::is_timestamp<Source>()) ||
+  ((k == cudf::aggregation::MIN || k == cudf::aggregation::MAX) && cudf::is_fixed_width<Source>() &&
+   cudf::has_atomic_support<device_storage_type_t<Source>>());
+
+/**
+ * @brief Batched (row-unrolled) variant of `shmem_element_aggregator`.
+ *
+ * Processes U rows of one column per call. For SUM/MIN/MAX on fixed-width sources it first issues
+ * all U validity checks and value loads, then applies the U shared-memory atomics, so the loads are
+ * in flight together instead of each atomic waiting on its own load. Other aggregation kinds fall
+ * back to the per-element path for each active row.
+ */
+template <int U>
+struct shmem_batch_aggregator {
+  template <typename Source, cudf::aggregation::Kind k>
+  __device__ void operator()(cuda::std::byte* target,
+                             bool* target_mask,
+                             cudf::size_type const (&target_index)[U],
+                             bool const (&active)[U],
+                             cudf::column_device_view source,
+                             cudf::size_type const (&source_index)[U]) const noexcept
+  {
+    constexpr bool preload = shmem_batch_preload_v<Source, k>;
+    if constexpr (preload) {
+      using DeviceTarget = cudf::device_storage_type_t<cudf::detail::target_type_t<Source, k>>;
+      using DeviceSource = cudf::device_storage_type_t<Source>;
+      DeviceSource value[U];
+      bool valid[U];
+#pragma unroll
+      for (int r = 0; r < U; ++r) {
+        valid[r] = active[r] && source.is_valid(source_index[r]);
+        value[r] = valid[r] ? source.element<DeviceSource>(source_index[r]) : DeviceSource{};
+      }
+      DeviceTarget* target_casted = reinterpret_cast<DeviceTarget*>(target);
+#pragma unroll
+      for (int r = 0; r < U; ++r) {
+        if (!valid[r]) { continue; }
+        auto const ti = target_index[r];
+        if (!target_mask[ti]) { cudf::detail::atomic_max(target_mask + ti, true); }
+        if constexpr (k == cudf::aggregation::SUM) {
+          cudf::detail::atomic_add(&target_casted[ti], static_cast<DeviceTarget>(value[r]));
+        } else if constexpr (k == cudf::aggregation::MIN) {
+          cudf::detail::atomic_min(&target_casted[ti], static_cast<DeviceTarget>(value[r]));
+        } else {
+          cudf::detail::atomic_max(&target_casted[ti], static_cast<DeviceTarget>(value[r]));
+        }
+      }
+    } else {
+#pragma unroll
+      for (int r = 0; r < U; ++r) {
+        if (active[r]) {
+          shmem_element_aggregator{}.template operator()<Source, k>(
+            target, target_mask, target_index[r], source, source_index[r]);
+        }
+      }
+    }
+  }
+};
 }  // namespace cudf::groupby::detail::hash
