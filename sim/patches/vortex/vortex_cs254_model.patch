+// --- cs254 project patch (sim/patches/vortex/vortex_launch_log.patch) ---
+// When the environment variable VX_LAUNCH_LOG names a file, every kernel launch (run()) and every
+// cache flush that follows it append one line there, so a multi-kernel host program gets exact
+// per-launch simulated cycles, instructions and DRAM requests. (The MPM report printed at device
+// close mixes free-running core counters with memory counters that reset at each launch.)
+static FILE* vx_launch_log() {
+  static FILE* f = []() -> FILE* {
+    const char* p = std::getenv("VX_LAUNCH_LOG");
+    return (p && p[0]) ? std::fopen(p, "a") : nullptr;
+  }();
+  return f;
+}
+
+static uint64_t vx_total_instrs(const std::vector<Cluster::Ptr>& clusters) {
+  uint64_t n = 0;
+  for (auto& cl : clusters) {
+    for (uint32_t c = 0; ; ++c) {
+      auto core = cl->get_core(c);
+      if (core == nullptr) break;
+      n += core->perf_stats().instrs;
+    }
+  }
+  return n;
+}
+// --- end cs254 patch ---
